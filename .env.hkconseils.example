# ─────────────────────────────────────────────────────────────────────────────
# HKCONSEILS — modèle de configuration locale.
# Copier en `.env` et renseigner les valeurs de VOTRE infrastructure.
# `.env` n est JAMAIS commité. Ce dépôt est public : aucune adresse réelle ne
# doit apparaître dans un fichier versionné.
# ─────────────────────────────────────────────────────────────────────────────

# Clé de la passerelle LLM.
export OPENAI_API_KEY=<votre-cle>

# Point d entrée du moteur « cerveau », interrogé en direct par le triage de
# signaux et le vérificateur de watchlist.
export HKCONSEILS_BRAIN_URL=http://<moteur-cerveau>:<port>
export HKCONSEILS_BRAIN_URL_V1=http://<moteur-cerveau>:<port>/v1

# Surcharge de point d entrée par modèle, le cas échéant :
#   HKCONSEILS_BASE_URL__<MODELE_EN_MAJUSCULES_AVEC_UNDERSCORES>
