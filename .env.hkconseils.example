# ─────────────────────────────────────────────────────────────────────────────
# HKCONSEILS — modèle de configuration locale du fork.
# Copier en `.env` et renseigner les valeurs de VOTRE infrastructure.
# `.env` n est JAMAIS commité (voir .gitignore). Ce dépôt est public :
# aucune adresse réelle ne doit apparaître dans un fichier versionné.
# Documentation complète : HKCONSEILS_CONFIG.md
# ─────────────────────────────────────────────────────────────────────────────

# --- Passerelle LLM (point d entrée unique du chemin trading) ---------------
# Clé maître de la passerelle. Le provider openai_compatible lit CETTE variable,
# et non OPENAI_API_KEY.
export OPENAI_COMPATIBLE_API_KEY=<votre-cle>

export TRADINGAGENTS_LLM_PROVIDER=openai_compatible
export TRADINGAGENTS_LLM_BACKEND_URL=http://<passerelle>:<port>/v1
export TRADINGAGENTS_DEEP_THINK_LLM=<alias-modele-cerveau>
export TRADINGAGENTS_QUICK_THINK_LLM=<alias-modele-ouvrier>

# --- Résilience et paramètres de run ----------------------------------------
export TRADINGAGENTS_LLM_MAX_RETRIES=3
export TRADINGAGENTS_OUTPUT_LANGUAGE=French
export TRADINGAGENTS_MAX_DEBATE_ROUNDS=1
export TRADINGAGENTS_MAX_RISK_ROUNDS=1

# --- Accès directs, hors passerelle -----------------------------------------
# Le triage de signaux et le vérificateur de watchlist interrogent le moteur
# « cerveau » en direct (appels courts, hors chemin de décision).
export HKCONSEILS_BRAIN_URL=http://<moteur-cerveau>:<port>
export HKCONSEILS_BRAIN_URL_V1=http://<moteur-cerveau>:<port>/v1

# Résumeur de débat (mode observation), via la passerelle.
export HKCONSEILS_GATEWAY_URL=http://<passerelle>:<port>/v1

# --- Non définis volontairement ---------------------------------------------
# HKCONSEILS_MAX_TOKENS  : plafond porté par le code et la passerelle (§3 du guide)
# HKCONSEILS_SDK_TIMEOUT : délai porté par le code (§4 du guide)
# Les définir ici ajouterait une troisième source de vérité.
